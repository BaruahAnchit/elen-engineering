{
  "rules": {
    "jobs": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["active"],
      "$jobId": {
        ".validate": "newData.hasChildren(['title','dept','level','location','active'])",
        "title":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "dept":      { ".validate": "newData.isString() && ['Engineering','Manufacturing','Quality','Sales','Human Resources'].contains(newData.val())" },
        "level":     { ".validate": "newData.val() === 'Entry level' || newData.val() === 'Experienced'" },
        "location":  { ".validate": "newData.isString() && newData.val().length <= 120" },
        "skills":    { ".validate": "newData.isString() && newData.val().length <= 300" },
        "desc":      { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "active":    { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },

    "applications": {
      ".read": "auth != null && auth.token.admin === true",
      "$appId": {
        ".write": "(auth != null && !data.exists() && newData.child('uid').val() === auth.uid) || (auth != null && auth.token.admin === true)",
        ".validate": "newData.hasChildren(['uid','jobId','name','email','cvPath','createdAt'])",
        "uid":      { ".validate": "newData.isString()" },
        "jobId":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
        "jobTitle": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "name":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "email":    { ".validate": "newData.isString() && newData.val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/) && newData.val().length <= 254" },
        "phone":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "message":  { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "cvPath":   { ".validate": "newData.isString() && newData.val().beginsWith('cvs/' + auth.uid + '/')" },
        "status":   { ".validate": "newData.val() === 'new' || (auth != null && auth.token.admin === true)" },
        "emailSent":{ ".validate": "newData.val() === false || (auth != null && auth.token.admin === true)" },
        "createdAt":{ ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other":   { ".validate": false }
      }
    }
  }
}
