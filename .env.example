# Firebase web app config (Firebase console > Project settings > Your apps).
# These values identify the project and are safe to ship in client code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=elen-engineering-career-page.firebaseapp.com
# Use the regional URL shown in the Realtime Database console, e.g.
# https://elen-engineering-career-page-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=elen-engineering-career-page
VITE_FIREBASE_STORAGE_BUCKET=elen-engineering-career-page.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key to turn on Firebase App Check
VITE_RECAPTCHA_SITE_KEY=
# Optional: link shown next to the consent checkbox
VITE_PRIVACY_URL=
# Set to "true" to talk to the local Emulator Suite
VITE_USE_EMULATORS=false
