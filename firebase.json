{
  "hosting": {
    "public": "client/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "asia-south1" }
      },
        {
          "source": "**",
          "function": "api"
        }
      ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "elen-engineering-career-page",
        "supportEmail": "support@elen-engineering-career-page.firebaseapp.com"
      }
    }
  }
}
