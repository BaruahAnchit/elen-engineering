# Copy to functions/.env.<your-project-id>  (e.g. .env.elen-engineering-career-page)
# Non-secret settings. The SMTP password is a secret: firebase functions:secrets:set SMTP_PASS

# Inbox that receives every application. Never exposed to the browser.
HR_EMAIL=hr@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username

# Verified sender address on your email provider, e.g.  ELEN Careers <careers@yourdomain.com>
MAIL_FROM=ELEN Careers <careers@example.com>

# Send the candidate a short acknowledgement email (true/false)
SEND_AUTOREPLY=false
